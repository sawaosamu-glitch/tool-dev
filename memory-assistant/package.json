{
  "name": "memory-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "個人用ローカルナレッジベース＋QAアプリ",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/unit/**/*.test.js tests/integration/**/*.test.js",
    "test:e2e": "node --test tests/e2e/**/*.test.js",
    "test:all": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-exclude=public/**",
    "lint": "find src public/app.js -name '*.js' -exec node --check {} \\;"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.22.2",
    "better-sqlite3": "^13.0.3"
  }
}
